    "@angular/forms": "~22.2.7",
    "@angular/platform-browser": "~22.2.7",
    "@angular/router": "~22.2.7",
    "@supabase/supabase-js": "^2.119.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "~22.2.8",
    "@angular/cli": "~22.2.8",
    "@angular/compiler-cli": "~22.2.7",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.8.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "supabase": "3.0.0",
